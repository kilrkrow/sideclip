<Window x:Class="Sideclip.Picker.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#801A1B26"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowState="Maximized"
        FontFamily="Cascadia Mono, Consolas, Courier New"
        Foreground="#E5E9F6"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewTextInput="OnPreviewTextInput"
        MouseLeftButtonDown="OnScrimClick">
    <Grid>
        <Border x:Name="Card"
                Width="875"
                Height="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#2E323F"
                BorderBrush="#C0C9D4"
                BorderThickness="1"
                CornerRadius="0"
                MouseLeftButtonDown="OnCardClick">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="18,16,18,6">
                    <Button x:Name="ClearButton"
                            DockPanel.Dock="Right"
                            Content="Clear"
                            Padding="10,2"
                            Margin="12,0,0,0"
                            FontSize="13"
                            Foreground="#ABAFBC"
                            Background="Transparent"
                            BorderBrush="#3E424F"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="OnClearClick" />
                    <TextBlock x:Name="Header"
                               FontSize="16"
                               Foreground="#ABAFBC"
                               VerticalAlignment="Center"
                               Text="Search clipboard..." />
                </DockPanel>
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="List"
                             Grid.Column="0"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#E5E9F6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnRowActivate"
                             SelectionChanged="OnSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="Margin" Value="8,0,8,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Foreground" Value="#E5E9F6" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3A414D" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <Border Grid.Column="1" Width="1" Background="#3E424F" Margin="0,8" />
                    <Grid Grid.Column="2" Margin="16,8,16,16">
                        <TextBlock x:Name="PreviewText"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="#D2D5DC" />
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Visibility="Collapsed" />
                        <TextBlock x:Name="EmptyHint"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#6E727F"
                                   Text="Clipboard is empty"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>

