<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 projections are only for the optional Windows OCR; runs on Windows 10 1809+. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Keep the historic bin\<Config>\net8.0-windows\ layout that scripts and the agent skill look for. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net8.0-windows\</OutputPath>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Sideclip</RootNamespace>
    <AssemblyName>Sideclip</AssemblyName>
    <ApplicationTitle>Sideclip</ApplicationTitle>
    <ApplicationIcon>Assets/sideclip.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
    <Authors>kilrkrow</Authors>
    <Product>Sideclip</Product>
    <Copyright>Copyright (c) 2026 kilrkrow</Copyright>
    <Description>Windows tray clipboard that sits beside Win+V.</Description>
    <!-- The unit tests live in their own project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>


