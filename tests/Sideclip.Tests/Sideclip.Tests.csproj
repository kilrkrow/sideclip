<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sideclip.Tests</RootNamespace>
  </PropertyGroup>

  <!-- The logic under test has no UI dependencies, so it is compiled in directly
       instead of referencing the WPF app. -->
  <ItemGroup>
    <Compile Include="..\..\Obsidian\*.cs" Link="Linked\Obsidian\%(Filename)%(Extension)" />
    <Compile Include="..\..\Screenshot\ScreenshotRules.cs" Link="Linked\Screenshot\ScreenshotRules.cs" />
    <Compile Include="..\..\Screenshot\FileCopier.cs" Link="Linked\Screenshot\FileCopier.cs" />
    <Compile Include="..\..\Screenshot\ScreenshotCopier.cs" Link="Linked\Screenshot\ScreenshotCopier.cs" />
    <Compile Include="..\..\Settings\IssueNotifier.cs" Link="Linked\Settings\IssueNotifier.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
